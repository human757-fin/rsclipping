* text=auto

# Keep shell scripts and AppImage runtime files LF (CRLF breaks shebangs)
*.sh text eol=lf
AppRun text eol=lf
install.sh text eol=lf
package-linux.sh text eol=lf
rsclipping.desktop text eol=lf

# PS1 scripts are fine as-is (PowerShell handles both)
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binaries must not be normalized
*.png binary
*.ico binary
*.exe binary
*.AppImage binary
*.zip binary